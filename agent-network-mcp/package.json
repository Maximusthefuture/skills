{
  "name": "agent-network-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for protocol-driven collaboration between AI coding agents (DISCUSS -> IMPLEMENT -> SYNC -> DONE)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-network-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "start": "node dist/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
